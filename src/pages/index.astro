---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/landing/Hero.astro";
import ProblemSplit from "@/components/landing/ProblemSplit.astro";
import UseCases from "@/components/landing/UseCases.astro";
import Approach from "@/components/landing/Approach.astro";
import TeamGrid from "@/components/landing/TeamGrid.astro";
import FAQ from "@/components/landing/FAQ.astro";
import BlogTeaser from "@/components/landing/BlogTeaser.astro";
import CTA from "@/components/landing/CTA.astro";

const title = "ReliaParse - Contracts say one price. Invoices say another.";
const description =
  "ReliaParse checks every invoice against your contracts, continuously, and produces evidence-grade findings your procurement and finance teams can act on.";
---

<Layout title={title} description={description} currentPage="landing">
  <Hero collection="landingReliacheck" showAnimation={false} />
  <ProblemSplit collection="landingReliacheck" />
  <UseCases collection="landingReliacheck" />
  <Approach collection="landingReliacheck" />
  <TeamGrid collection="landingReliacheck" />
  <FAQ collection="landingReliacheck" faqCollection="faqReliacheck" />
  <BlogTeaser />
  <CTA collection="landingReliacheck" />
</Layout>
