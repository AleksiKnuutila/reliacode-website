---
// ReliaCheck landing page — a sibling brand/product page served at
// /reliacheck, reusing the same landing-page components as ReliaParse's
// home page but pointed at the "landingReliacheck" / "faqReliacheck"
// content collections (src/content/landing-reliacheck/,
// src/content/faq-reliacheck/) and rebranded via the `brandName` prop
// on Layout. Does not touch or replace ReliaParse's own index.astro.
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/landing/Hero.astro";
import ProblemSplit from "@/components/landing/ProblemSplit.astro";
import HowItWorks from "@/components/landing/HowItWorks.astro";
import Approach from "@/components/landing/Approach.astro";
import TeamGrid from "@/components/landing/TeamGrid.astro";
import FAQ from "@/components/landing/FAQ.astro";
import CTA from "@/components/landing/CTA.astro";

const title = "ReliaCheck - Contracts say one price. Invoices say another.";
const description =
  "ReliaCheck checks every invoice against your contracts, continuously, and produces evidence-grade findings your procurement and finance teams can act on.";
---

<Layout
  title={title}
  description={description}
  currentPage="landing"
  brandName="ReliaCheck"
>
  <Hero collection="landingReliacheck" />
  <ProblemSplit collection="landingReliacheck" />
  <HowItWorks collection="landingReliacheck" />
  <Approach collection="landingReliacheck" />
  <TeamGrid collection="landingReliacheck" />
  <FAQ collection="landingReliacheck" faqCollection="faqReliacheck" />
  <CTA collection="landingReliacheck" />
</Layout>
